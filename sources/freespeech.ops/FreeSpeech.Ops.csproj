<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared operations toolkit of the FreeSpeech servers (relay, push gateway): runtime log control, in-memory log
       ring, per-identity trace, local admin guard and the command-line plumbing. No dependency on the protocol or the client. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FreeSpeech.Ops</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.1" />
    <!-- MailKit/MimeKit bring System.Security.Cryptography.Pkcs 10.0.0, which has known vulnerabilities (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7): the fixed version is named here and reaches every project that uses this library. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
