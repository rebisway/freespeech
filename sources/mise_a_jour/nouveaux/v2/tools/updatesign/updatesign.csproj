<Project Sdk="Microsoft.NET.Sdk">

  <!-- Makes and signs the update manifest (latest.json) from version.props: see scripts/make-update-manifest.ps1. Run on the publisher's PC, never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FreeSpeech.UpdateSign</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\freespeech.client\FreeSpeech.Client.csproj" />
  </ItemGroup>

</Project>
