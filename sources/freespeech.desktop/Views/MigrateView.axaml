<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FreeSpeech.Desktop.ViewModels"
             xmlns:g="using:FreeSpeech.Client.Groups"
             x:Class="FreeSpeech.Desktop.Views.MigrateView"
             x:DataType="vm:MigrateViewModel">
	<ScrollViewer>
		<StackPanel Margin="24,18" Spacing="12" MaxWidth="600" HorizontalAlignment="Stretch">
			<!-- Step 1: who takes over my groups, and the old phrases that sign the notice. -->
			<StackPanel Spacing="12" IsVisible="{Binding IsStep1}">
				<TextBlock Text="{Binding IntroText}" Classes="hint" FontSize="12" />
				<TextBlock Text="{Binding GroupsTitle}" Classes="section" FontSize="15" Margin="0,8,0,0" />
				<TextBlock Text="{Binding NoGroupsText}" Classes="hint" FontSize="12" IsVisible="{Binding NoGroups}" />
				<ItemsControl ItemsSource="{Binding Roles}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:RoleRow">
							<StackPanel Spacing="4" Margin="0,0,0,10">
								<TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
								<TextBlock Text="{Binding Explanation}" Classes="hint" FontSize="12" />
								<ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding Successor}" PlaceholderText="{Binding PickHint}" IsVisible="{Binding IsCreator}" HorizontalAlignment="Stretch">
									<ComboBox.ItemTemplate><DataTemplate x:DataType="g:GroupMember"><TextBlock Text="{Binding Nickname}" /></DataTemplate></ComboBox.ItemTemplate>
								</ComboBox>
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<TextBlock Text="{Binding OldPhrasesTitle}" Classes="section" FontSize="15" Margin="0,8,0,0" />
				<TextBox Text="{Binding Old1}" PlaceholderText="1" AcceptsReturn="True" TextWrapping="Wrap" />
				<TextBox Text="{Binding Old2}" PlaceholderText="2" AcceptsReturn="True" TextWrapping="Wrap" />
				<TextBox Text="{Binding Old3}" PlaceholderText="3" AcceptsReturn="True" TextWrapping="Wrap" />
				<Button Content="{Binding ContinueLabel}" Command="{Binding ContinueCommand}" IsEnabled="{Binding !Busy}" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,10" />
			</StackPanel>

			<!-- Step 2: the notice is out; switch to the new identity once it has reached everyone. -->
			<StackPanel Spacing="12" IsVisible="{Binding IsStep2}">
				<TextBlock Text="{Binding SentTitle}" Classes="section" FontSize="15" />
				<TextBlock Text="{Binding NewIdText}" Classes="hint" FontSize="12" />
				<TextBlock Text="{Binding WaitText}" Classes="hint" FontSize="12" />
				<TextBlock Text="{Binding PendingText}" FontWeight="SemiBold" />
				<Button Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
				<TextBlock Text="{Binding FinishHint}" Classes="hint" FontSize="12" Margin="0,8,0,0" />
				<TextBox Text="{Binding New1}" PlaceholderText="1" AcceptsReturn="True" TextWrapping="Wrap" />
				<TextBox Text="{Binding New2}" PlaceholderText="2" AcceptsReturn="True" TextWrapping="Wrap" />
				<TextBox Text="{Binding New3}" PlaceholderText="3" AcceptsReturn="True" TextWrapping="Wrap" />
				<Button Content="{Binding FinishLabel}" Command="{Binding FinishCommand}" IsEnabled="{Binding !Busy}" Background="{DynamicResource DangerBrush}" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,10" />
			</StackPanel>

			<TextBlock Text="{Binding Result}" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" IsVisible="{Binding Result, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
		</StackPanel>
	</ScrollViewer>
</UserControl>
