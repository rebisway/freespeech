<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FreeSpeech.Desktop.ViewModels"
             xmlns:c="using:FreeSpeech.Desktop.Controls"
             xmlns:s="using:FreeSpeech.Desktop.Services"
             x:Class="FreeSpeech.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
	<ScrollViewer>
		<StackPanel Margin="24,18" Spacing="12" MaxWidth="600" HorizontalAlignment="Stretch">
			<TextBlock Text="{Binding ProfileTitle}" Classes="section" FontSize="15" />
			<StackPanel Orientation="Horizontal" Spacing="12">
				<c:Avatar Size="72" Title="{Binding Nickname}" Photo="{Binding MyPhoto}" />
				<Button Classes="icon" VerticalAlignment="Center" Command="{Binding PickPhotoCommand}" ToolTip.Tip="{Binding PhotoTip}"><PathIcon Data="{StaticResource Icon.photo}" /></Button>
				<Button Classes="icon" VerticalAlignment="Center" Command="{Binding RemovePhotoCommand}" ToolTip.Tip="{Binding RemoveTip}"><PathIcon Data="{StaticResource Icon.close}" /></Button>
			</StackPanel>
			<TextBox Text="{Binding Nickname}" PlaceholderText="{Binding NicknameHint}" />
			<TextBox Text="{Binding About}" PlaceholderText="{Binding AboutHint}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxLength="300" />
			<Button Classes="icon" HorizontalAlignment="Left" Command="{Binding SaveProfileCommand}" ToolTip.Tip="{Binding SaveTip}"><PathIcon Data="{StaticResource Icon.check}" /></Button>

			<TextBlock Text="{Binding LanguageTitle}" Classes="section" FontSize="15" Margin="0,12,0,0" />
			<ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" HorizontalAlignment="Stretch">
				<ComboBox.ItemTemplate><DataTemplate x:DataType="s:LanguageInfo"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
			</ComboBox>
			<StackPanel Orientation="Horizontal" Spacing="12">
				<Button Classes="icon" Command="{Binding ImportLanguageCommand}" ToolTip.Tip="{Binding LangImportTip}"><PathIcon Data="{StaticResource Icon.add}" /></Button>
				<Button Classes="icon" Command="{Binding SaveTemplateCommand}" ToolTip.Tip="{Binding LangTemplateTip}"><PathIcon Data="{StaticResource Icon.send}" /></Button>
				<Button Classes="icon" IsVisible="{Binding CanRemoveLanguage}" Command="{Binding RemoveLanguageCommand}" ToolTip.Tip="{Binding LangRemoveTip}"><PathIcon Data="{StaticResource Icon.close}" /></Button>
			</StackPanel>

			<TextBlock Text="{Binding ThemeTitle}" Classes="section" FontSize="15" Margin="0,12,0,0" />
			<ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" HorizontalAlignment="Stretch">
				<ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ThemeOption"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
			</ComboBox>

			<TextBlock Text="{Binding AutoDlTitle}" Classes="section" FontSize="15" Margin="0,12,0,0" />
			<TextBlock Text="{Binding AutoDlHint}" Classes="hint" FontSize="12" />
			<NumericUpDown Value="{Binding AutoDownloadMb}" Minimum="0" Maximum="2000" Increment="1" FormatString="0" HorizontalAlignment="Left" Width="140" />

			<TextBlock Text="{Binding ConfirmSendTitle}" Classes="section" FontSize="15" Margin="0,12,0,0" />
			<TextBlock Text="{Binding ConfirmSendHint}" Classes="hint" FontSize="12" />
			<NumericUpDown Value="{Binding ConfirmSendMb}" Minimum="0" Maximum="2000" Increment="1" FormatString="0" HorizontalAlignment="Left" Width="140" />

			<TextBlock Text="{Binding ReceiptsTitle}" Classes="section" FontSize="15" Margin="0,12,0,0" />
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
				<TextBlock Text="{Binding ReceiptsHint}" Classes="hint" FontSize="12" VerticalAlignment="Center" />
				<ToggleSwitch Grid.Column="1" IsChecked="{Binding SendReadReceipts}" OnContent="" OffContent="" VerticalAlignment="Center" />
			</Grid>

			<TextBlock Text="{Binding TypingTitle}" Classes="section" FontSize="15" Margin="0,12,0,0" />
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
				<TextBlock Text="{Binding TypingHint}" Classes="hint" FontSize="12" VerticalAlignment="Center" />
				<ToggleSwitch Grid.Column="1" IsChecked="{Binding TypingIndicator}" OnContent="" OffContent="" VerticalAlignment="Center" />
			</Grid>

			<TextBlock Text="{Binding NotificationsTitle}" Classes="section" FontSize="15" Margin="0,12,0,0" />
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
				<TextBlock Text="{Binding NotificationsHint}" Classes="hint" FontSize="12" VerticalAlignment="Center" />
				<ToggleSwitch Grid.Column="1" IsChecked="{Binding Notifications}" OnContent="" OffContent="" VerticalAlignment="Center" />
			</Grid>

			<TextBlock Text="{Binding OutboxTitle}" Classes="section" FontSize="15" Margin="0,12,0,0" />
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
				<TextBlock Text="{Binding OutboxHint}" Classes="hint" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
				<ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowOutbox}" OnContent="" OffContent="" VerticalAlignment="Center" />
			</Grid>

			<TextBlock Text="{Binding StartupTitle}" Classes="section" FontSize="15" Margin="0,12,0,0" />
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
				<TextBlock Text="{Binding StartupHint}" Classes="hint" FontSize="12" VerticalAlignment="Center" />
				<ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchAtStartup}" OnContent="" OffContent="" VerticalAlignment="Center" />
			</Grid>

			<!-- Optional PIN, off by default: asked when the window comes back after a delay of non-use. -->
			<TextBlock Text="{Binding LockTitle}" Classes="section" FontSize="15" Margin="0,12,0,0" />
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
				<TextBlock Text="{Binding LockHint}" Classes="hint" FontSize="12" VerticalAlignment="Center" />
				<ToggleSwitch Grid.Column="1" IsChecked="{Binding LockEnabled}" OnContent="" OffContent="" VerticalAlignment="Center" />
			</Grid>
			<StackPanel IsVisible="{Binding LockEnabled}" Spacing="8">
				<TextBlock Text="{Binding LockDelayText}" Classes="hint" FontSize="12" />
				<ComboBox ItemsSource="{Binding LockDelays}" SelectedItem="{Binding SelectedLockDelay}" HorizontalAlignment="Stretch">
					<ComboBox.ItemTemplate><DataTemplate x:DataType="vm:LockOption"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
				</ComboBox>
				<TextBlock Text="{Binding LockWipeText}" Classes="hint" FontSize="12" />
				<ComboBox ItemsSource="{Binding WipeOptions}" SelectedItem="{Binding SelectedWipe}" HorizontalAlignment="Stretch">
					<ComboBox.ItemTemplate><DataTemplate x:DataType="vm:LockOption"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
				</ComboBox>
				<Button Classes="icon" HorizontalAlignment="Left" Command="{Binding ChangePinCommand}" ToolTip.Tip="{Binding LockChangeTip}"><PathIcon Data="{StaticResource Icon.key}" /></Button>
			</StackPanel>

			<TextBlock Text="{Binding WipeTitle}" Classes="section" FontSize="15" Margin="0,12,0,0" />
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
				<TextBlock Text="{Binding WipeHint}" Classes="hint" FontSize="12" VerticalAlignment="Center" />
				<Button Grid.Column="1" Classes="icon" Command="{Binding OpenWipeCommand}" ToolTip.Tip="{Binding WipeTip}"><PathIcon Data="{StaticResource Icon.settings}" /></Button>
			</Grid>

			<!-- After a theft: move to a new identity, and how to follow the migration of a contact. -->
			<TextBlock Text="{Binding MigrationTitle}" Classes="section" FontSize="15" Margin="0,12,0,0" />
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
				<TextBlock Text="{Binding MigrationHint}" Classes="hint" FontSize="12" VerticalAlignment="Center" />
				<Button Grid.Column="1" Classes="icon" Command="{Binding OpenMigrateCommand}" ToolTip.Tip="{Binding MigrationTip}"><PathIcon Data="{StaticResource Icon.key}" /></Button>
			</Grid>
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
				<TextBlock Text="{Binding MigrateExcludeHint}" Classes="hint" FontSize="12" VerticalAlignment="Center" />
				<ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoExcludeMigrated}" OnContent="" OffContent="" VerticalAlignment="Center" />
			</Grid>
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
				<TextBlock Text="{Binding MigrateAutoHint}" Classes="hint" FontSize="12" VerticalAlignment="Center" />
				<ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoAcceptMigration}" OnContent="" OffContent="" VerticalAlignment="Center" />
			</Grid>

			<TextBlock Text="{Binding DiagTitle}" Classes="section" FontSize="15" Margin="0,12,0,0" />
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
				<TextBlock Text="{Binding DiagHint}" Classes="hint" FontSize="12" VerticalAlignment="Center" />
				<ToggleSwitch Grid.Column="1" IsChecked="{Binding DiagLogEnabled}" OnContent="" OffContent="" VerticalAlignment="Center" />
			</Grid>
			<Button Content="{Binding DiagOpenLabel}" Command="{Binding OpenDiagFolderCommand}" IsVisible="{Binding DiagLogEnabled}" HorizontalAlignment="Left" />

			<TextBlock Text="{Binding KeyFileTitle}" Classes="section" FontSize="15" Margin="0,12,0,0" />
			<TextBlock Text="{Binding KeyFileHint}" Classes="hint" FontSize="12" />
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
				<TextBox Text="{Binding KeyFilePassword}" PasswordChar="●" PlaceholderText="{Binding KeyFilePasswordHint}" />
				<Button Grid.Column="1" Classes="icon" Command="{Binding VerifyKeyFileCommand}" IsEnabled="{Binding !KeyFileBusy}" ToolTip.Tip="{Binding KeyFilePickTip}"><PathIcon Data="{StaticResource Icon.key}" /></Button>
			</Grid>

			<TextBlock Text="{Binding ServersTitle}" Classes="section" FontSize="15" Margin="0,12,0,0" />
			<ItemsControl ItemsSource="{Binding Servers}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:ServerRow">
						<Grid ColumnDefinitions="*,Auto" Margin="0,2">
							<StackPanel VerticalAlignment="Center">
								<TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis" />
								<TextBlock Text="{Binding Status}" Classes="hint" FontSize="12" />
								<StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanRequestAccess}" Margin="0,4,0,0">
									<Button Content="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RequestAccessLabel}" FontSize="12" Padding="12,4"
									        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RequestAccessCommand}" CommandParameter="{Binding}" />
									<Button Content="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).UseInvitationLabel}" FontSize="12" Padding="12,4"
									        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).UseInvitationCommand}" CommandParameter="{Binding}" />
								</StackPanel>
							</StackPanel>
							<Button Grid.Column="1" Classes="icon" ToolTip.Tip="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveTip}"
							        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveServerCommand}" CommandParameter="{Binding}"><PathIcon Data="{StaticResource Icon.close}" /></Button>
						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
				<TextBox Text="{Binding NewServer}" PlaceholderText="{Binding ServerHint}" />
				<Button Grid.Column="1" Classes="icon" Command="{Binding AddServerCommand}" ToolTip.Tip="{Binding AddTip}"><PathIcon Data="{StaticResource Icon.add}" /></Button>
			</Grid>

			<TextBlock Text="{Binding VersionText}" Classes="hint" FontSize="12" HorizontalAlignment="Center" Margin="0,18,0,0" />
			<TextBlock Text="{Binding Status}" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
		</StackPanel>
	</ScrollViewer>
</UserControl>