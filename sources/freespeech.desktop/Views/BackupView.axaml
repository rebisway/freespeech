<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FreeSpeech.Desktop.ViewModels"
             x:Class="FreeSpeech.Desktop.Views.BackupView"
             x:DataType="vm:BackupViewModel">
	<ScrollViewer>
		<StackPanel Margin="24,20" Spacing="14" MaxWidth="560" HorizontalAlignment="Stretch">
			<TextBlock Text="{Binding MakeTitle}" Classes="section" />
			<TextBlock Text="{Binding MakeText}" Classes="hint" FontSize="12" />
			<ComboBox ItemsSource="{Binding Modes}" SelectedIndex="{Binding ModeIndex}" HorizontalAlignment="Stretch" />
			<Button Classes="icon" HorizontalAlignment="Left" Command="{Binding BackupCommand}" IsEnabled="{Binding !Busy}" ToolTip.Tip="{Binding MakeTitle}"><PathIcon Data="{StaticResource Icon.backup}" /></Button>

			<TextBlock Text="{Binding RestoreTitle}" Classes="section" Margin="0,10,0,0" />
			<TextBlock Text="{Binding RestoreText}" Classes="hint" FontSize="12" />
			<Button Classes="icon" HorizontalAlignment="Left" Command="{Binding RestoreCommand}" IsEnabled="{Binding !Busy}" ToolTip.Tip="{Binding RestoreTitle}"><PathIcon Data="{StaticResource Icon.restore}" /></Button>

			<TextBlock Text="{Binding Status}" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
		</StackPanel>
	</ScrollViewer>
</UserControl>