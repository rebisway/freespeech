<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FreeSpeech.Desktop.ViewModels"
        xmlns:v="using:FreeSpeech.Desktop.Views"
        x:Class="FreeSpeech.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="FreeSpeech" Width="440" Height="820" MinWidth="340" MinHeight="520"
        Icon="avares://FreeSpeech/Assets/freespeech.ico">
	<Grid>
		<TextBlock IsVisible="{Binding Busy}" Text="…" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" />
		<v:OnboardingView IsVisible="{Binding ShowOnboarding}" IsEnabled="{Binding LockIsOff}" />

		<Grid IsVisible="{Binding ShowMain}" IsEnabled="{Binding LockIsOff}" RowDefinitions="Auto,Auto,*">
			<!-- Title bar, as on the mobile app: the menu on the left, the screen's title, the name and the flag on the right. -->
			<Border Grid.Row="0" IsVisible="{Binding ShowTopBar}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="6,6">
				<Grid ColumnDefinitions="Auto,*,Auto">
					<Button Grid.Column="0" Classes="iconflat" Command="{Binding ToggleMenuCommand}" IsVisible="{Binding !CanPop}"><PathIcon Data="{StaticResource Icon.menu}" /></Button>
					<Button Grid.Column="0" Classes="iconflat" Command="{Binding PopCommand}" IsVisible="{Binding CanPop}"><PathIcon Data="{StaticResource Icon.back}" /></Button>
					<TextBlock Grid.Column="1" Text="{Binding PageTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis" />
					<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,0,8,0" VerticalAlignment="Center">
							<TextBlock Text="FreeSpeech" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
							<!-- The flag, with a small badge at its bottom right that tells where I stand on my servers (as on the mobile app). A click says it in words. -->
							<Button Classes="iconflat" Width="32" Height="32" Padding="0" Command="{Binding ExplainServersCommand}" VerticalAlignment="Center">
								<Grid Width="28" Height="28">
									<Image Source="{Binding FlagImage}" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" />
									<Viewbox Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="{Binding BadgeVisible}">
										<Canvas Width="24" Height="24">
											<Ellipse Canvas.Left="0.8" Canvas.Top="0.8" Width="22.4" Height="22.4" Fill="#1B1814" Stroke="#4A4036" StrokeThickness="1.2" />
											<Path Data="{Binding BadgeGlyph}" Fill="{Binding BadgeBrush}" RenderTransform="translate(5px,5px) scale(0.583,0.583)" />
											<Line StartPoint="5,5" EndPoint="19,19" Stroke="{Binding BadgeBrush}" StrokeThickness="2.6" StrokeLineCap="Round" IsVisible="{Binding BadgeSlash}" />
										</Canvas>
									</Viewbox>
								</Grid>
							</Button>
						</StackPanel>
				</Grid>
			</Border>

			<!-- Another device of the identity asks to be mirrored: touch to type the code it shows. -->
			<Button Grid.Row="1" IsVisible="{Binding SyncPending}" Command="{Binding EnterSyncCodeCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="0"
			        Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}" Padding="10,8">
				<TextBlock Text="{Binding SyncBarText}" FontWeight="SemiBold" />
			</Button>

			<Grid Grid.Row="2">
				<!-- Conversations: the list beside the chat. -->
				<Grid IsVisible="{Binding IsChatsPage}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="{Binding ListColumn}" />
						<ColumnDefinition Width="{Binding ChatColumn}" />
					</Grid.ColumnDefinitions>
					<v:ConversationListView Grid.Column="0" />
					<Border Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
						<Grid>
							<ContentControl Content="{Binding Chat}">
								<ContentControl.DataTemplates>
									<DataTemplate DataType="vm:ChatViewModel"><v:ChatView /></DataTemplate>
								</ContentControl.DataTemplates>
							</ContentControl>
							<TextBlock IsVisible="{Binding ShowPlaceholder}" Text="{Binding NoChatText}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Grid>
					</Border>
				</Grid>

				<!-- The other screens of the menu. -->
				<ContentControl Content="{Binding PageContent}" IsVisible="{Binding !IsChatsPage}">
					<ContentControl.DataTemplates>
						<DataTemplate DataType="vm:InviteViewModel"><v:InviteView /></DataTemplate>
						<DataTemplate DataType="vm:ApproveViewModel"><v:ApproveView /></DataTemplate>
						<DataTemplate DataType="vm:ContactsPageViewModel"><v:ContactsPageView /></DataTemplate>
						<DataTemplate DataType="vm:GroupsPageViewModel"><v:GroupsPageView /></DataTemplate>
						<DataTemplate DataType="vm:NewGroupViewModel"><v:NewGroupView /></DataTemplate>
						<DataTemplate DataType="vm:ArchiveViewModel"><v:ArchiveView /></DataTemplate>
						<DataTemplate DataType="vm:OutboxViewModel"><v:OutboxView /></DataTemplate>
						<DataTemplate DataType="vm:BackupViewModel"><v:BackupView /></DataTemplate>
						<DataTemplate DataType="vm:SettingsViewModel"><v:SettingsView /></DataTemplate>
						<DataTemplate DataType="vm:WipeViewModel"><v:WipeView /></DataTemplate>
						<DataTemplate DataType="vm:SafetyViewModel"><v:SafetyView /></DataTemplate>
						<DataTemplate DataType="vm:GroupInfoViewModel"><v:GroupInfoView /></DataTemplate>
						<DataTemplate DataType="vm:MigrateViewModel"><v:MigrateView /></DataTemplate>
						<DataTemplate DataType="vm:PhrasesSaveViewModel">
							<ScrollViewer><v:PhrasesSaveView Margin="24,18" MaxWidth="560" HorizontalAlignment="Stretch" /></ScrollViewer>
						</DataTemplate>
						<DataTemplate DataType="vm:SoonViewModel">
							<TextBlock Text="{Binding Text}" Classes="hint" HorizontalAlignment="Center" Margin="24" />
						</DataTemplate>
					</ContentControl.DataTemplates>
				</ContentControl>
			</Grid>

			<!-- The side menu: slides over the screen, the rest of the window dims; a click outside closes it. -->
			<Grid Grid.RowSpan="3" IsVisible="{Binding MenuOpen}">
				<Button Background="#99000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding CloseMenuCommand}" CornerRadius="0" />
				<Border HorizontalAlignment="Left" Width="250" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
					<DockPanel>
						<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="16,20,16,12">
							<Image Source="{Binding FlagImage}" Width="30" Height="30" />
							<TextBlock Text="FreeSpeech" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
						</StackPanel>
						<ItemsControl ItemsSource="{Binding MenuItems}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:MenuItem">
									<Button Classes="menu" Classes.selected="{Binding IsSelected}" IsVisible="{Binding IsVisible}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="40" Padding="0"
									        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).NavigateCommand}" CommandParameter="{Binding}">
										<Grid ColumnDefinitions="44,*">
											<PathIcon Data="{Binding Icon}" Foreground="{DynamicResource PrimaryBrush}" Width="18" Height="18" />
											<TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
										</Grid>
									</Button>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</DockPanel>
				</Border>
			</Grid>
		</Grid>
		<!-- The PIN screen: opaque, over everything. -->
		<ContentControl Content="{Binding Lock}">
			<ContentControl.DataTemplates>
				<DataTemplate DataType="vm:LockViewModel"><v:LockView /></DataTemplate>
			</ContentControl.DataTemplates>
		</ContentControl>
	</Grid>
</Window>
