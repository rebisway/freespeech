<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FreeSpeech.Desktop.ViewModels"
             xmlns:c="using:FreeSpeech.Desktop.Controls"
             x:Class="FreeSpeech.Desktop.Views.ContactsPageView"
             x:DataType="vm:ContactsPageViewModel">
	<DockPanel>
		<TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" Margin="24,8" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
		<Grid>
			<TextBlock Text="{Binding EmptyText}" Classes="hint" HorizontalAlignment="Center" Margin="0,24" IsVisible="{Binding IsEmpty}" />
			<ScrollViewer>
				<ItemsControl ItemsSource="{Binding Contacts}" MaxWidth="640">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:ContactRow">
							<Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="14,10" Background="Transparent">
								<Grid.GestureRecognizers />
								<c:Avatar Margin="0,0,14,0" Title="{Binding Nickname}" Photo="{Binding Photo}" />
								<Button Grid.Column="1" Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0"
								        Command="{Binding $parent[ItemsControl].((vm:ContactsPageViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
									<StackPanel VerticalAlignment="Center" Spacing="1">
										<TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
										<TextBlock Text="{Binding Subtitle}" Classes="hint" FontSize="12" IsVisible="{Binding HasSubtitle}" TextTrimming="CharacterEllipsis" />
										<TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="12" MaxLines="2" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasDescription}" />
									</StackPanel>
								</Button>
								<Button Grid.Column="2" Classes="iconflat" ToolTip.Tip="{Binding $parent[ItemsControl].((vm:ContactsPageViewModel)DataContext).RenameTip}"
								        Command="{Binding $parent[ItemsControl].((vm:ContactsPageViewModel)DataContext).RenameCommand}" CommandParameter="{Binding}"><PathIcon Data="{StaticResource Icon.edit}" /></Button>
								<Button Grid.Column="3" Classes="iconflat" ToolTip.Tip="{Binding $parent[ItemsControl].((vm:ContactsPageViewModel)DataContext).VerifyTip}"
								        Command="{Binding $parent[ItemsControl].((vm:ContactsPageViewModel)DataContext).VerifyCommand}" CommandParameter="{Binding}"><PathIcon Data="{StaticResource Icon.shield}" /></Button>
								<Button Grid.Column="4" Classes="iconflat" IsVisible="{Binding CanRoute}" ToolTip.Tip="{Binding $parent[ItemsControl].((vm:ContactsPageViewModel)DataContext).RouteTip}"
								        Command="{Binding $parent[ItemsControl].((vm:ContactsPageViewModel)DataContext).RouteCommand}" CommandParameter="{Binding}"><PathIcon Data="{StaticResource Icon.key}" /></Button>
								<Button Grid.Column="5" Classes="iconflat" ToolTip.Tip="{Binding $parent[ItemsControl].((vm:ContactsPageViewModel)DataContext).DeleteTip}"
								        Command="{Binding $parent[ItemsControl].((vm:ContactsPageViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}"><PathIcon Data="{StaticResource Icon.delete}" /></Button>
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Grid>
	</DockPanel>
</UserControl>