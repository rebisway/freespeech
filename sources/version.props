<Project>

	<!-- Version and release date of every program, each on its own: a fix of the push gateway does not change the version of the mobile app.
	     The single source, written in clear so that a build gives the same result under any version control or from an archive.
	     Raised by scripts/bump-version.ps1 -Component <relay|push|console|desktop|mobile> before publishing that program. -->
	<PropertyGroup>
		<FsRelayVersion>1.5.2</FsRelayVersion>
		<FsRelayVersionDate>2026-10-19</FsRelayVersionDate>

		<FsPushVersion>1.3.1</FsPushVersion>
		<FsPushVersionDate>2026-10-18</FsPushVersionDate>

		<FsDirectoryVersion>1.1.1</FsDirectoryVersion>
		<FsDirectoryVersionDate>2026-10-18</FsDirectoryVersionDate>

		<FsConsoleVersion>1.1.1</FsConsoleVersion>
		<FsConsoleVersionDate>2026-10-17</FsConsoleVersionDate>

		<FsDesktopVersion>1.3.2</FsDesktopVersion>
		<FsDesktopVersionDate>2026-10-21</FsDesktopVersionDate>

		<!-- The mobile app also has a build number (the Android versionCode): it only goes up, Android refuses to "update" to a lower or equal one. -->
		<FsMobileVersion>1.3.4</FsMobileVersion>
		<FsMobileVersionDate>2026-10-22</FsMobileVersionDate>
		<FsMobileBuild>309</FsMobileBuild>
	</PropertyGroup>

</Project>
