<Project Sdk="Microsoft.NET.Sdk">

  <!-- A "java.exe" that stands between the Android workload's R8 task and the real java: see Program.cs. Built by FreeSpeech.Mobile.csproj, never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>java</AssemblyName>
    <RootNamespace>FreeSpeech.JavaWrap</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
