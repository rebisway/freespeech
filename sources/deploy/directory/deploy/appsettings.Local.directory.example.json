// FreeSpeech directory - secrets file.
//
// Copy to /var/www/freespeech_directory/appsettings.Local.json (next to FreeSpeech.Directory.dll), then:
//   sudo chown www-data:www-data /var/www/freespeech_directory/appsettings.Local.json
//   sudo chmod 600               /var/www/freespeech_directory/appsettings.Local.json
// Replace every <...> value. Check the result: dotnet FreeSpeech.Directory.dll check
//
// This is the only place for secrets: not the .service file, not the repository, not a published folder (an update never contains it).
// Generate the secret with `openssl rand -hex 32`. Never put it in a command line, a ticket or a chat.
{
  // Admin:Secret - the key to this directory's local admin API (the "admin" command). Belongs to this directory alone: not shared,
  // and different from a relay's. Empty: every admin route refuses.
  "Admin": {
    "Secret": "<openssl rand -hex 32>"
  },

  // Peer:PublicUrl - the https address of this directory. Relays that are asked for a link use it to check who asks.
  // Peer:Name - how this directory presents itself to the relays.
  // Peer:Contact - how a relay administrator can reach yours to check who is asking (a mail address, a phone number, a page).
  "Peer": {
    "PublicUrl": "<https://directory.example.org>",
    "Name": "directory",
    "Contact": "admin@example.org"
  }

  // Written by the admin commands, not to be edited by hand (the password is never shown): 'admin smtp set host|port|tls|user|from|to|prefix <value>',
  // 'admin smtp set password', 'admin smtp test', then 'admin notify on'. Smtp:Password is a secret and lives only in this file.
  // ,"Smtp": { "Host": "smtp.example.org", "Port": 587, "Tls": "starttls", "User": "robot", "Password": "<set with admin smtp set password>", "From": "freespeech@example.org", "To": "admin@example.org" }
  // ,"Notify": { "Enabled": true }
  // Not secrets (changed while it runs with 'admin settings'; these are the starting values): "Directory": { "ExpiryMinutes": 10, "ProbeMinutes": 30, "ListSize": 3 }
}
