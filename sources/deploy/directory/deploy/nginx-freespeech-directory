# FreeSpeech directory - nginx site (copy to /etc/nginx/sites-available/freespeech-directory, link into sites-enabled,
# then: sudo certbot --nginx -d directory1.exemple.org). HTTP only on purpose: certbot adds the TLS block.
#
# Called by clients that know no relay (once, at their first connection) and by relays (one heartbeat every two minutes).
# No access log: the directory keeps no address of the clients that ask.
limit_req_zone $binary_remote_addr zone=freespeech_directory:1m rate=2r/s;

server {
    listen 80;
    server_name directory1.exemple.org;

    client_max_body_size 1k;
    access_log off;

    # The admin API (command "admin ...") is local only: not published, whatever the secret.
    location /admin { return 404; }

    location / {
        limit_req zone=freespeech_directory burst=20 nodelay;

        proxy_pass http://127.0.0.1:5294;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
