// FreeSpeech relay server - secrets file.
//
// Copy to /var/www/freespeech_relay/appsettings.Local.json (next to FreeSpeech.Relay.dll), then:
//   sudo chown www-data:www-data /var/www/freespeech_relay/appsettings.Local.json
//   sudo chmod 600               /var/www/freespeech_relay/appsettings.Local.json
// Replace the <...> value. Check the result: dotnet FreeSpeech.Relay.dll check
//
// This is the only place for secrets: not the .service file, not the repository, not a published folder (an update never contains it).
// Generate the secret with `openssl rand -hex 32`. Never put it in a command line, a ticket or a chat.
{
  // Admin:Secret - the key to this server's local admin API (the "admin" command). Belongs to this server alone: not shared,
  // and different from the push gateway's. Empty: every admin route refuses.
  "Admin": {
    "Secret": "<openssl rand -hex 32>"
  }

  // Not secrets: uncomment and adapt.
  //   Name       how this relay is presented to the other administrator when linking with push gateways and other relays (`admin add push|relay <url>`; default: the machine name)
  //   PublicUrl  this relay's public address, the one in the phones' settings: other servers reach it there (required to link with another relay),
  //              and a private relay states it to its administration console (required to create groups)
  // ,"Peer": { "Name": "fs.example.org", "PublicUrl": "https://fs.example.org", "Contact": "admin@example.org" }

  // Written by the admin commands, not to be edited by hand (the password is never shown): 'admin smtp set host|port|tls|user|from|to|prefix <value>',
  // 'admin smtp set password', 'admin smtp test', then 'admin notify on'. Smtp:Password is a secret and lives only in this file.
  // ,"Smtp": { "Host": "smtp.example.org", "Port": 587, "Tls": "starttls", "User": "robot", "Password": "<set with admin smtp set password>", "From": "freespeech@example.org", "To": "admin@example.org", "SubjectPrefix": "[{kind}] {host}" }
  // ,"Notify": { "Enabled": true }

  // Directory: the directories this relay is linked with (`admin add directory <url>`) are told its country and its places left every
  // Directory:HeartbeatSeconds (120). The country is a setting changed while the relay runs, `admin settings set country FR`
  // (starting value: "Directory": { "Country": "FR" }); the places left come from `admin settings set max-connections`.
}
