// FreeSpeech push gateway - secrets file.
//
// Copy to /var/www/freespeech_push/appsettings.Local.json (next to FreeSpeech.Push.dll), then:
//   sudo chown www-data:www-data /var/www/freespeech_push/appsettings.Local.json
//   sudo chmod 600               /var/www/freespeech_push/appsettings.Local.json
//   sudo chmod 700               /var/www/freespeech_push/secrets
// Replace every <...> value. Check the result: dotnet FreeSpeech.Push.dll check
//
// This is the only place for secrets: not the .service file, not the repository, not a published folder (an update never contains it).
// Generate each secret with `openssl rand -hex 32`, one per purpose, never reused. Never put one in a command line, a ticket or a chat.
// The Firebase service-account file can send notifications to every installation of the app: keep it in /var/www/freespeech_push/secrets/
// (files 600, www-data only), never in the repository, and only on this gateway.
{
  // Admin:Secret - the key to this gateway's local admin API (the "admin" command). Belongs to this gateway alone: not shared,
  // and different from a relay's. Empty: every admin route refuses.
  "Admin": {
    "Secret": "<openssl rand -hex 32>"
  },

  // Fcm:ServiceAccountFile - path of the Firebase service-account JSON (Firebase console > Project settings > Service accounts >
  // Generate new private key). Missing: no Android wake-ups. Apns (iOS) takes the same kind of file: "Apns": { "KeyFile": ..., "KeyId": ...,
  // "TeamId": ..., "BundleId": ..., "Production": true }.
  "Fcm": {
    "ServiceAccountFile": "/var/www/freespeech_push/secrets/firebase-service-account.json"
  }

  // Not secrets, only needed to link this gateway with relays (`admin add relay <url>`): uncomment and adapt.
  //   Name       how this gateway is presented to the relay's administrator (default: the machine name)
  //   PublicUrl  this gateway's address as relays reach it (required to ask a relay)
  // ,"Peer": { "Name": "push.example.org", "PublicUrl": "https://push.example.org", "Contact": "admin@example.org" }
  //
  // Relays are allowed on the gateway itself, not here: `admin accept <id>` after a relay asked (`admin requests`).

  // Written by the admin commands, not to be edited by hand (the password is never shown): 'admin smtp set host|port|tls|user|from|to|prefix <value>',
  // 'admin smtp set password', 'admin smtp test', then 'admin notify on'. Smtp:Password is a secret and lives only in this file.
  // ,"Smtp": { "Host": "smtp.example.org", "Port": 587, "Tls": "starttls", "User": "robot", "Password": "<set with admin smtp set password>", "From": "freespeech@example.org", "To": "admin@example.org", "SubjectPrefix": "[{kind}] {host}" }
  // ,"Notify": { "Enabled": true }
}
