<?xml version="1.0" encoding="utf-8"?>
<!-- Development only: clear HTTP to 127.0.0.1, reached through `adb reverse tcp:5299 tcp:5299` (emulator and phone over USB,
     see the AdbReversePortForDebug target of the project). Real servers are HTTPS; add nothing else here. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>