<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android is the first real target (iOS comes later, same code: the client library is managed and its
		     cryptography is BouncyCastle, which runs on iOS too). net10.0-windows is only there to iterate on the UI
		     without an emulator. Not part of FreeSpeech.slnx: building it needs the Android workload and SDK, see
		     FreeSpeech.Mobile.slnx. Clone under a pure-ASCII path: AAPT2 refuses other characters. -->
		<TargetFrameworks>net10.0-android36.0</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- MVVMTK0045: only relevant to an AOT WinRT publish, which we do not do (WindowsPackageType=None). -->
		<NoWarn>$(NoWarn);MVVMTK0045</NoWarn>

		<OutputType>Exe</OutputType>
		<RootNamespace>FreeSpeech.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- XAML source generation: XAML compiled to C# at build time (faster start, errors at build). -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>FreeSpeech</ApplicationTitle>
		<ApplicationId>org.freespeech.mobile</ApplicationId>
		<!-- Version, date and build number come from sources/version.props (scripts/bump-version.ps1 -Component mobile raises them). The build number only goes up:
		     Android refuses to "update" to a lower or equal one. -->
		<ApplicationDisplayVersion>$(FsMobileVersion)</ApplicationDisplayVersion>
		<ApplicationVersion>$(FsMobileBuild)</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>

		<!-- Debug builds normally use Fast Deployment: assemblies are pushed to files/.__override__ instead of the APK, and
		     "Clear data" (or an APK-only install) deletes them, so the app aborts at start ("No assemblies found").
		     Embedding them keeps the APK self-contained and clearing data harmless. -->
		<EmbedAssembliesIntoApk Condition="$(TargetFramework.Contains('-android'))">true</EmbedAssembliesIntoApk>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.png" Color="#0B0B0D" />
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#0B0B0D" BaseSize="256,256" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- The app's texts, one JSON file per language (see Localization/Loc.cs). -->
		<EmbeddedResource Include="Localization\Lang\*.json" LogicalName="Lang.%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="QRCoder" Version="1.8.0" />
		<!-- Video compression (resize + re-encode) before sending. -->
		<PackageReference Include="Xamarin.AndroidX.Media3.Transformer" Version="1.11.1" Condition="$(TargetFramework.Contains('-android'))" />
		<PackageReference Include="Xamarin.AndroidX.Media3.Effect" Version="1.11.1" Condition="$(TargetFramework.Contains('-android'))" />
		<!-- Background check for new messages when the app is not running (the polling fallback of PROTOCOL §9). -->
		<PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.11.1.1" Condition="$(TargetFramework.Contains('-android'))" />
		<PackageReference Include="ZXing.Net.Maui.Controls" Version="0.10.4" Condition="$(TargetFramework.Contains('-android'))" />
		<!-- ZXing brings CameraX 1.4.2, whose native libraries are built with an old NDK (Google Play 16 KB warning): the newer one is referenced directly. -->
		<PackageReference Include="Xamarin.AndroidX.Camera.Core" Version="1.6.2" Condition="$(TargetFramework.Contains('-android'))" />
		<PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.2" Condition="$(TargetFramework.Contains('-android'))" />
		<PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.2" Condition="$(TargetFramework.Contains('-android'))" />
		<PackageReference Include="Xamarin.AndroidX.Camera.Video" Version="1.6.2" Condition="$(TargetFramework.Contains('-android'))" />
		<PackageReference Include="Xamarin.AndroidX.Camera.View" Version="1.6.2" Condition="$(TargetFramework.Contains('-android'))" />
	</ItemGroup>

	<!-- Push wake-up through Firebase Cloud Messaging (PROTOCOL §9). Only when google-services.json (from the Firebase project, never
	     committed) sits next to this file: without it the app builds and runs, and the polling fallback does the work. -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-android')) and Exists('google-services.json')">
		<DefineConstants>$(DefineConstants);FCM</DefineConstants>
	</PropertyGroup>
	<ItemGroup Condition="$(TargetFramework.Contains('-android')) and Exists('google-services.json')">
		<GoogleServicesJson Include="google-services.json" />
		<PackageReference Include="Xamarin.Firebase.Messaging" Version="125.1.3" />
		<!-- Firebase pulls AndroidX Lifecycle 2.11, WorkManager 2.10: take the newer one explicitly (a NuGet version-range warning remains). -->
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
	</ItemGroup>
	<ItemGroup>
		<!-- All the messaging logic: identity, relay, contacts, groups, files, encrypted storage. No UI in it. -->
		<ProjectReference Include="..\freespeech.client\FreeSpeech.Client.csproj" />
	</ItemGroup>

	<!-- The APK scripts (scripts/build-apk-*.ps1) pick the processor family: -p:FsRuntimeIds=android-arm64 (phones) or android-x64 (emulators). Set here, in the
	     project, and not as a global RuntimeIdentifier(s) property: that one would also reach the client library and break its build. Without it, the SDK default (arm64 + x64). -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-android')) and '$(FsRuntimeIds)' != ''">
		<RuntimeIdentifiers>$(FsRuntimeIds)</RuntimeIdentifiers>
	</PropertyGroup>

	<!-- Release on Android: R8 shrinks, optimises and renames the Java/Kotlin side (the DEX), which Google Play asks to be optimised. The workload's R8 task writes
	     -dontobfuscate at the top of proguard_xamarin.cfg every time, just before it starts java: the target below puts sources\tools\javawrap (a "java.exe" that removes that line
	     and starts the real java) in its place for that task only. The rules for what .NET reaches through JNI are generated (and keep their names); the others are in proguard.cfg.
	     -p:FsObfuscate=false builds without renaming. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' and $(TargetFramework.Contains('-android'))">
		<AndroidLinkTool>r8</AndroidLinkTool>
		<AndroidEnableProguard>true</AndroidEnableProguard>
	</PropertyGroup>
	<ItemGroup Condition="'$(Configuration)' == 'Release' and $(TargetFramework.Contains('-android'))">
		<ProguardConfiguration Include="proguard.cfg" />
	</ItemGroup>
	<PropertyGroup>
		<_FsJavaWrapDir>$(MSBuildProjectDirectory)\obj\javawrap</_FsJavaWrapDir>
	</PropertyGroup>
	<Target Name="FsJavaWrapOn" BeforeTargets="_CompileToDalvik"
	        Condition="'$(Configuration)' == 'Release' and $(TargetFramework.Contains('-android')) and '$(FsObfuscate)' != 'false'">
		<Exec Command="dotnet build &quot;$(MSBuildProjectDirectory)\..\tools\javawrap\javawrap.csproj&quot; -c Release -o &quot;$(_FsJavaWrapDir)&quot; -v q --nologo" StandardOutputImportance="low" />
		<WriteLinesToFile File="$(_FsJavaWrapDir)\java.real" Lines="$(JavaToolPath)" Overwrite="true" />
		<PropertyGroup>
			<_FsRealJavaToolPath>$(JavaToolPath)</_FsRealJavaToolPath>
			<JavaToolPath>$(_FsJavaWrapDir)</JavaToolPath>
		</PropertyGroup>
	</Target>
	<Target Name="FsJavaWrapOff" AfterTargets="_CompileToDalvik" Condition="'$(_FsRealJavaToolPath)' != ''">
		<PropertyGroup>
			<JavaToolPath>$(_FsRealJavaToolPath)</JavaToolPath>
		</PropertyGroup>
	</Target>	<!-- Debug on Android: the device's 127.0.0.1:5299 leads to the PC's server (emulator or phone over USB alike). -->
	<Target Name="AdbReversePortForDebug" BeforeTargets="_Run;_Install"
	        Condition="'$(Configuration)' == 'Debug' and '$(TargetPlatformIdentifier)' == 'android'">
		<Exec Command="for /f &quot;skip=1 tokens=1&quot; %%d in ('&quot;$(AndroidSdkDirectory)\platform-tools\adb.exe&quot; devices') do &quot;$(AndroidSdkDirectory)\platform-tools\adb.exe&quot; -s %%d reverse tcp:5299 tcp:5299" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low" />
	</Target>

	<!-- Default addresses chosen at build time (sources/Directory.Build.props, overridden by the unversioned freespeech.defaults.props), read by BuildDefaults.cs. -->
	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>DefaultServer</_Parameter1><_Parameter2>$(FsDefaultServer)</_Parameter2></AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>Directories</_Parameter1><_Parameter2>$(FsDirectories)</_Parameter2></AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>FallbackServers</_Parameter1><_Parameter2>$(FsFallbackServers)</_Parameter2></AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>VersionDate</_Parameter1><_Parameter2>$(FsMobileVersionDate)</_Parameter2></AssemblyAttribute>
	</ItemGroup>

</Project>

