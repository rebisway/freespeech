<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:loc="clr-namespace:FreeSpeech.Mobile.Localization" xmlns:ctl="clr-namespace:FreeSpeech.Mobile.Controls" x:Class="FreeSpeech.Mobile.Views.InvitePage">
    <Shell.TitleView><ctl:BrandTitleView Heading="{loc:Tr invite_heading}" /></Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14">
            <!-- Giving my details: face to face, a code to scan (the quickest and surest); at a distance, a message or a copy. -->
            <Label Text="{loc:Tr invite_send_title}" FontFamily="OpenSansSemibold" FontSize="20" TextColor="{StaticResource Primary}" />
            <Label Text="{loc:Tr invite_send_hint}" TextColor="{StaticResource Gray200}" FontSize="14" Margin="0,-8,0,0" />
            <ctl:ActionRow Icon="ic_qr.png" Title="{loc:Tr invite_row_qr}" Hint="{loc:Tr invite_together}" Command="{Binding ToggleQrCommand}" />
            <Border BackgroundColor="White" Padding="8" StrokeShape="RoundRectangle 8" HorizontalOptions="Center" IsVisible="{Binding HasQr}">
                <Image Source="{Binding QrImage}" WidthRequest="260" HeightRequest="260" SemanticProperties.Description="{loc:Tr a11y_qr}" />
            </Border>
            <ctl:ActionRow Icon="ic_share.png" Title="{loc:Tr invite_row_share}" Hint="{loc:Tr invite_apart}" Command="{Binding ShareCommand}" />
            <ctl:ActionRow Icon="ic_copy.png" Title="{loc:Tr invite_row_copy}" Hint="{loc:Tr invite_row_copy_hint}" Command="{Binding CopyCommand}" />

            <!-- Receiving someone's details. -->
            <Label Text="{loc:Tr invite_recv_title}" FontFamily="OpenSansSemibold" FontSize="20" TextColor="{StaticResource Primary}" Margin="0,26,0,0" />
            <Label Text="{loc:Tr invite_recv_hint}" TextColor="{StaticResource Gray200}" FontSize="14" Margin="0,-8,0,0" />
            <ctl:ActionRow Icon="ic_scan.png" Title="{loc:Tr invite_row_scan}" Hint="{loc:Tr invite_together}" Command="{Binding ScanCommand}" />
            <ctl:ActionRow Icon="ic_paste.png" Title="{loc:Tr invite_row_paste}" Hint="{loc:Tr invite_row_paste_hint}" Command="{Binding PasteCommand}" />

            <Label Text="{Binding Status}" FontSize="15" TextColor="{StaticResource Secondary}" IsVisible="{Binding Status, Converter={StaticResource StringNotEmptyConverter}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
