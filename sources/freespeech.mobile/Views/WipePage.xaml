<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:loc="clr-namespace:FreeSpeech.Mobile.Localization" xmlns:ctl="clr-namespace:FreeSpeech.Mobile.Controls" x:Class="FreeSpeech.Mobile.Views.WipePage">
    <Shell.TitleView><ctl:BrandTitleView Heading="{loc:Tr wipe_title}" /></Shell.TitleView>
    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="12">
            <Label Text="{loc:Tr wipe_hint}" TextColor="{StaticResource Gray200}" FontSize="13" />
            <Label x:Name="State" FontFamily="OpenSansSemibold" />

            <Label Text="{loc:Tr wipe_phrases}" TextColor="{StaticResource Gray200}" FontSize="13" Margin="0,8,0,0" />
            <Editor x:Name="Phrase1" AutoSize="TextChanges" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" Placeholder="1" />
            <Editor x:Name="Phrase2" AutoSize="TextChanges" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" Placeholder="2" />
            <Editor x:Name="Phrase3" AutoSize="TextChanges" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" Placeholder="3" />

            <Button x:Name="ActivateButton" Text="{loc:Tr wipe_activate}" Clicked="OnActivate" />
            <Button x:Name="SendButton" Text="{loc:Tr wipe_send}" BackgroundColor="{StaticResource Danger}" Clicked="OnSend" />
            <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False" />
            <Label x:Name="Result" TextColor="{StaticResource Secondary}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
