<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:loc="clr-namespace:FreeSpeech.Mobile.Localization" xmlns:ctl="clr-namespace:FreeSpeech.Mobile.Controls" x:Class="FreeSpeech.Mobile.Views.BackupPage">
    <Shell.TitleView><ctl:BrandTitleView Heading="{loc:Tr nav_backup}" /></Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14">
            <Label Text="{loc:Tr backup_make_title}" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource Primary}" />
            <Label Text="{loc:Tr backup_make_text}" TextColor="{StaticResource Gray200}" FontSize="13" />
            <Picker x:Name="ModePicker" ItemsSource="{Binding Modes}" SelectedIndex="{Binding ModeIndex}" />
            <ImageButton Source="ic_backup.png" StyleClass="Icon" HorizontalOptions="Start" Margin="0,0,0,44" Command="{Binding BackupCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" SemanticProperties.Description="{loc:Tr backup_make_title}" />

            <Label Text="{loc:Tr restore_title}" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource Primary}" />
            <Label Text="{loc:Tr restore_text}" TextColor="{StaticResource Gray200}" FontSize="13" />
            <ImageButton Source="ic_restore.png" StyleClass="Icon" HorizontalOptions="Start" Margin="0,0,0,44" Command="{Binding RestoreCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" SemanticProperties.Description="{loc:Tr restore_title}" />

            <Label Text="{loc:Tr arch_entry_title}" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource Primary}" />
            <Label Text="{loc:Tr arch_entry_text}" TextColor="{StaticResource Gray200}" FontSize="13" />
            <ImageButton Source="ic_archive.png" StyleClass="Icon" HorizontalOptions="Start" Margin="0,0,0,44" Command="{Binding OpenArchiveCommand}" SemanticProperties.Description="{loc:Tr arch_entry_go}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding Status}" TextColor="{StaticResource Secondary}" IsVisible="{Binding Status, Converter={StaticResource StringNotEmptyConverter}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
