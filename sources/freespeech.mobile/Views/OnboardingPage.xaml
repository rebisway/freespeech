<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:svc="clr-namespace:FreeSpeech.Mobile.Services" xmlns:loc="clr-namespace:FreeSpeech.Mobile.Localization" xmlns:ctl="clr-namespace:FreeSpeech.Mobile.Controls" x:Class="FreeSpeech.Mobile.Views.OnboardingPage" Shell.NavBarIsVisible="False" Shell.FlyoutBehavior="Disabled">
    <ScrollView>
        <VerticalStackLayout Padding="22,36" Spacing="14">
            <HorizontalStackLayout Spacing="12">
                <Image Source="{x:Static svc:ThemeService.Logo}" WidthRequest="44" HeightRequest="44" VerticalOptions="Center" />
                <Label Text="FreeSpeech" FontSize="30" FontFamily="OpenSansSemibold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Label Text="{Binding Title}" FontSize="20" />
            <Label Text="{Binding Explanation}" TextColor="{StaticResource Gray200}" />

            <!-- Step 1: two plain choices, nothing to type. -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsChoose}">
                <ctl:ActionRow Icon="ic_person_add.png" Title="{loc:Tr onb_row_first}" Hint="{loc:Tr onb_row_first_hint}" Command="{Binding StartFirstCommand}" />
                <ctl:ActionRow Icon="ic_restore.png" Title="{loc:Tr onb_row_restore}" Hint="{loc:Tr onb_row_restore_hint}" Command="{Binding StartRestoreCommand}" />
            </VerticalStackLayout>

            <!-- First connection: just a name. -->
            <Entry Text="{Binding Nickname}" Placeholder="{loc:Tr onb_nickname}" IsVisible="{Binding IsFirst}" />

            <!-- Restore: the three phrases, then (optional) the backup file that gives back contacts and messages. -->
            <VerticalStackLayout Spacing="14" IsVisible="{Binding ShowPhraseFields}">
                <Editor Text="{Binding Phrase1}" Placeholder="{loc:Tr onb_phrase1}" AutoSize="TextChanges" MinimumHeightRequest="70" />
                <Editor Text="{Binding Phrase2}" Placeholder="{loc:Tr onb_phrase2}" AutoSize="TextChanges" MinimumHeightRequest="70" />
                <Editor Text="{Binding Phrase3}" Placeholder="{loc:Tr onb_phrase3}" AutoSize="TextChanges" MinimumHeightRequest="70" />
                <Button Text="{loc:Tr onb_paste}" Command="{Binding PastePhrasesCommand}" HorizontalOptions="Start" />
            </VerticalStackLayout>
            <!-- Other ways to bring the phrases back: a protected key file, or the printed sheet's QR code. -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowPhraseFields}">
                <ctl:ActionRow Icon="ic_key.png" Title="{loc:Tr onb_row_keyfile}" Hint="{loc:Tr onb_row_keyfile_hint}" Command="{Binding PickKeyFileCommand}" />
                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasKeyFile}">
                    <Label Text="{Binding KeyFileLabel}" TextColor="{StaticResource Secondary}" FontSize="14" />
                    <Entry Text="{Binding KeyPassword}" IsPassword="{Binding HideKeyPassword}" Placeholder="{loc:Tr onb_key_password}" />
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding ShowKeyPassword}" VerticalOptions="Center" />
                        <Label Text="{loc:Tr ph_show_password}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Button Text="{loc:Tr onb_key_open}" Command="{Binding OpenKeyFileCommand}" HorizontalOptions="Start" />
                </VerticalStackLayout>
                <ctl:ActionRow Icon="ic_scan.png" Title="{loc:Tr onb_row_sheet}" Hint="{loc:Tr onb_row_sheet_hint}" Command="{Binding ScanSheetCommand}" />
            </VerticalStackLayout>
            <ctl:ActionRow Icon="ic_backup.png" Title="{loc:Tr onb_row_backup}" Hint="{loc:Tr onb_row_backup_hint}" Command="{Binding PickBackupCommand}" IsVisible="{Binding IsRestore}" />
            <Label Text="{Binding RestoreLabel}" IsVisible="{Binding HasRestoreFile}" TextColor="{StaticResource Secondary}" FontSize="14" />

            <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowServer}">
                <Label Text="{loc:Tr onb_server}" TextColor="{StaticResource Gray200}" FontSize="12" />
                <Entry Text="{Binding ServerUrl}" Keyboard="Url" Placeholder="https://..." />
            </VerticalStackLayout>

            <Label Text="{Binding Error}" TextColor="{StaticResource Danger}" IsVisible="{Binding Error, Converter={StaticResource StringNotEmptyConverter}}" />
            <Button Text="{Binding SubmitText}" Command="{Binding SubmitCommand}" IsVisible="{Binding IsChoose, Converter={StaticResource InvertedBoolConverter}}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="{Binding AdvancedText}" Command="{Binding ToggleAdvancedCommand}" IsVisible="{Binding ShowAdvancedToggle}" BackgroundColor="Transparent" TextColor="{StaticResource Gray200}" FontSize="13" HorizontalOptions="Center" />
            <Button Text="{loc:Tr onb_back}" Command="{Binding BackCommand}" IsVisible="{Binding ShowAdvancedToggle}" BackgroundColor="Transparent" TextColor="{StaticResource Gray200}" FontSize="13" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>